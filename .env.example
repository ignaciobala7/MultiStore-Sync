# ─── Mercado Libre ────────────────────────────────────────────────────────────
# Obtenidos desde https://developers.mercadolibre.com.ar/apps
ML_CLIENT_ID=123456789
ML_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# Tokens iniciales (se renuevan automáticamente en ml_tokens.json)
ML_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxxxxxx
ML_REFRESH_TOKEN=TG-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Tiendanube ───────────────────────────────────────────────────────────────
# ID numérico de tu tienda (visible en la URL del panel o via API /stores/me)
TN_STORE_ID=123456

# Token de acceso obtenido al instalar la app en tu tienda
TN_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre de tu app y email de contacto (requeridos por Tiendanube en User-Agent)
TN_APP_NAME=ML-Tiendanube-Sync
TN_USER_EMAIL=tu@email.com

# ─── Anthropic (Claude IA) ────────────────────────────────────────────────────
# Obtenido en https://console.anthropic.com/settings/keys
# Si esta variable no está definida, el enriquecimiento con IA se desactiva
# automáticamente y se publican los productos con los datos originales de ML.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
